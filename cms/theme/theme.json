{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "1240px", "wideSize": "1440px"},
    "color": {"defaultPalette": false, "palette": [
      {"slug": "ink", "name": "Road charcoal", "color": "#111820"},
      {"slug": "gold", "name": "Brass", "color": "#c49a59"},
      {"slug": "paper", "name": "Warm ivory", "color": "#f4f0e8"},
      {"slug": "muted", "name": "Quiet grey", "color": "#b8b8b2"}
    ]},
    "typography": {"fluid": true, "fontFamilies": [
      {"slug": "body", "name": "Chapter sans", "fontFamily": "-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif"},
      {"slug": "display", "name": "Heritage serif", "fontFamily": "Georgia,Times New Roman,serif"}
    ]},
    "spacing": {"units": ["px", "rem", "vw", "%"]},
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {"background": "var:preset|color|ink", "text": "var:preset|color|paper"},
    "typography": {"fontFamily": "var:preset|font-family|body", "fontSize": "16px", "lineHeight": "1.7"},
    "spacing": {"blockGap": "20px"},
    "elements": {
      "heading": {"typography": {"fontFamily": "var:preset|font-family|display", "fontWeight": "400"}},
      "link": {"color": {"text": "var:preset|color|paper"}},
      "button": {"color": {"background": "var:preset|color|gold", "text": "var:preset|color|ink"}}
    }
  },
  "templateParts": [
    {"name": "header", "title": "Chapter header", "area": "header"},
    {"name": "footer", "title": "Chapter footer", "area": "footer"}
  ]
}
